/target
dist/
node_modules
*.log
__pycache__/
*.pyc

.DS_Store
apps/kimo-token-bar/src-tauri/target
apps/kimo-token-bar/src-tauri/gen/schemas

# dev-only: `kimo-token report --json` / `kimo-token icons --json` output that ?real=1 renders
apps/kimo-token-bar/report.json
apps/kimo-token-bar/icons.json

# build-macos.sh: hash of everything the test gate compiles; unchanged-since-green skip marker
.cargo-test-stamp

# static musl collector binaries, staged by scripts/bundle-collector.sh
apps/kimo-token-bar/src-tauri/resources/collector/

# Windows CLI staged by the NSIS build hook
apps/kimo-token-bar/src-tauri/resources/cli/

# diagnostics staged by scripts/prepare-windows-diagnostics.mjs before a
# Windows panel build (build-info.json, source.patch, extra-sources.json)
apps/kimo-token-bar/src-tauri/resources/diagnostics/

# a compiled CLI binary landed at apps/kimo-token-bar/kimo-token once and was swept
# into a commit; refuse the exact path — the global apps/ exclusion cannot
# catch it, because the !apps/ rule below re-opens the directory
/apps/kimo-token-bar/kimo-token

# global gitignore excludes apps/; the panel is product code, keep it here
!apps/

# internal working notes: deleted from history at the 2026-10-09 switch and
# untracked on disk since (docs/internal/PUBLIC_DELIVERY.md, "the one-time switch")
/AGENTS.md
/docs/internal/
/.bugx/
